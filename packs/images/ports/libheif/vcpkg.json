{
  "name": "libheif",
  "version": "1.21.2",
  "description": "libheif for Pulse's image preview pack: HEIC (libde265) and AVIF (dav1d) decoding only. Overlay of the vcpkg port: the GPL encoders (x265, x264) are not available.",
  "homepage": "http://www.libheif.org/",
  "license": "LGPL-3.0-only",
  "supports": "!xbox",
  "dependencies": [
    "libde265",
    {
      "name": "vcpkg-cmake",
      "host": true
    },
    {
      "name": "vcpkg-cmake-config",
      "host": true
    }
  ],
  "features": {
    "dav1d": {
      "description": "AVIF decoding via dav1d",
      "license": "BSD-2-Clause",
      "dependencies": [
        "dav1d"
      ]
    },
    "iso23001-17": {
      "description": "Support for ISO23001-17 (uncompressed) codec (experimental)",
      "license": "LGPL-3.0-only",
      "dependencies": [
        "zlib"
      ]
    },
    "jpeg": {
      "description": "JPEG decoding and encoding via libjpeg-turbo",
      "license": "BSD-3-Clause",
      "dependencies": [
        "libjpeg-turbo"
      ]
    },
    "openjpeg": {
      "description": "JPEG-2000 decoding and encoding via OpenJPEG",
      "license": "BSD-2-Clause",
      "dependencies": [
        "openjpeg"
      ]
    }
  },
  "port-version": 0
}
